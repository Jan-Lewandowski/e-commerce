{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service with Postgres-backed users and sessions",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js",
    "db:seed": "knex seed:run --knexfile knexfile.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "pg": "^8.20.0"
  }
}
